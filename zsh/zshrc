# Zsh-specific settings and configurations

# History settings
setopt share_history
setopt hist_ignore_all_dups
setopt inc_append_history
setopt EXTENDED_HISTORY

# Emacs keybindings (Ctrl+A/E/K/…) — zsh defaults to the vi keymap when
# $EDITOR contains "vi" (nvim qualifies), so declare it explicitly
bindkey -e

# Shell compatibility options
setopt SH_WORD_SPLIT        # Enable bash-style word splitting
setopt EXTENDED_GLOB        # Enable extended globbing
setopt INTERACTIVE_COMMENTS # Enable bash-style comments

# Navigation magic
setopt AUTO_CD              # Type directory name to cd into it
setopt AUTO_PUSHD           # cd pushes old dir to stack
setopt PUSHD_IGNORE_DUPS    # No duplicates in dir stack
setopt PUSHD_SILENT         # Don't print stack after pushd

HISTSIZE=50000
# Export SAVEHIST so shellcheck knows it's used by zsh internally
export SAVEHIST=50000
HISTFILE=~/.zsh_history

# sh/loader.sh owns module order for both shells. Phase one now, so
# completions and plugins below have PATH and the helper functions;
# phase two (dotfiles_load_modules) after the plugins are in place.
#
# DOTFILES steers which checkout loads, which is how a worktree gets
# tested without disturbing the installed one. A stale value left in
# the environment must not cost you a working shell, so drop it when it
# points at nothing and let the loader derive its own path instead.
[[ -r "${DOTFILES:-${HOME}/dev/dotfiles}/sh/loader.sh" ]] || unset DOTFILES
source "${DOTFILES:-${HOME}/dev/dotfiles}/sh/loader.sh"
dotfiles_load_core

# Add Homebrew completion directories before compinit without shelling out to brew.
if is_macos; then
  if [[ -d /opt/homebrew/share/zsh/site-functions ]]; then
    fpath=(/opt/homebrew/share/zsh/site-functions /opt/homebrew/share/zsh-completions ${fpath})
  elif [[ -d /usr/local/share/zsh/site-functions ]]; then
    fpath=(/usr/local/share/zsh/site-functions /usr/local/share/zsh-completions ${fpath})
  fi
fi

# Source custom configurations
source "${DOTFILES}/zsh/completion.zsh"

# Set initial terminal title for interactive, non-minimal Zsh sessions
if is_zsh && [[ $- == *i* ]] && ! is_minimal; then
  set_terminal_title
fi

# ZINIT - Zsh Plugin Manager
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -d "${ZINIT_HOME}" ]]; then
  mkdir -p "$(dirname "${ZINIT_HOME}")"
  git clone https://github.com/zdharma-continuum/zinit.git "${ZINIT_HOME}"
fi
source "${ZINIT_HOME}/zinit.zsh"

# Load plugins with Zinit
# Using 'light' for faster loading without reporting/investigation
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-history-substring-search
zinit light Aloxaf/fzf-tab

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Atuin: Modern shell history with per-directory awareness
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Atuin replaces Ctrl+R with a full-screen fuzzy search UI
# Features: SQLite backend, directory filtering, cross-machine sync, stats
# The actual `atuin init` happens once in sh/fzf.sh (after fzf's bindings,
# so atuin wins ^R) — initializing here too would double the subprocess
# spawn and race the keybinds.
if command -v atuin &>/dev/null; then
  # Custom strategy for zsh-autosuggestions using Atuin's per-directory history
  _zsh_autosuggest_strategy_atuin() {
    suggestion=$(atuin search --cmd-only --limit 1 --search-mode prefix -- "$1" 2>/dev/null)
  }
  # Use Atuin first, fall back to standard history if no match
  ZSH_AUTOSUGGEST_STRATEGY=(atuin history completion)
fi

# Note: Up/down arrows handled by Atuin with workspace filtering
# history-substring-search still available via Ctrl+P/Ctrl+N if needed
bindkey '^P' history-substring-search-up
bindkey '^N' history-substring-search-down

# Initialize Starship prompt (cached — regenerates when the binary updates)
cached_eval starship starship-init.zsh starship init zsh --print-full-init

# Add other plugins here, e.g.:
# zinit light zdharma-continuum/fast-syntax-highlighting # Alternative syntax highlighting
# zinit light romkatv/powerlevel10k # If you want Zinit to manage P10k

# Phase two: the rest of sh/, sourced directly. They used to go through
# `zinit snippet`, but zinit copies local snippets into its cache and
# never invalidates them, so interactive shells were running months-old
# module code while the repo moved on. Direct sourcing is a few ms (the
# expensive tool inits inside are mtime-cached via cached_eval) and what
# you edit is what runs.
dotfiles_load_modules

# Command not found handler
if [[ -f /usr/share/doc/pkgfile/command-not-found.zsh ]]; then
  source /usr/share/doc/pkgfile/command-not-found.zsh
elif [[ -f /etc/zsh_command_not_found ]]; then
  source /etc/zsh_command_not_found
fi

# Update Zinit-managed plugins (shell modules are sourced directly, so
# repo edits apply on the next shell — no cache to refresh)
alias zzz='zinit update'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Zsh Power Features
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# zmv — batch renaming: zmv '(*).txt' '$1.md'
autoload -Uz zmv

# Edit current command in $EDITOR (Ctrl+X, Ctrl+E)
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^x^e' edit-command-line

# Named directories — teleportation shortcuts
# Usage: cd ~dots, vim ~cfg/ghostty/config
hash -d dots=~/dev/dotfiles
hash -d cfg=~/.config
hash -d dev=~/dev

# Global aliases — expand anywhere in pipeline
alias -g G='| grep'
alias -g L='| less'
alias -g J='| jq .'
alias -g NE='2>/dev/null'

# Suffix aliases — open files by extension
alias -s md='code'
alias -s json='jq .'
alias -s git='git clone'

# pnpm PATH handled in env.sh (unified PATH construction)
safe_source "${HOME}/.ghcup/env"
