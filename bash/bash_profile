# ~/.bash_profile
# Login shell initialization for bash on macOS
# Sources ~/.bashrc.local for all shell configurations

# Source .bashrc.local if it exists
if [[ -f ~/.bashrc.local ]]; then
  source ~/.bashrc.local
fi

# proto
export PROTO_HOME="$HOME/.proto";
export PATH="$PROTO_HOME/shims:$PROTO_HOME/bin:$PATH";
