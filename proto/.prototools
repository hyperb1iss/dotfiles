# Every tool pinned here loads its plugin on each `proto activate` (every cd),
# so keep this list to tools proto actually manages. rust lives in rustup and
# the proto self-pin kept going stale, so both were dropped. zig comes from
# Homebrew; proto has no built-in zig plugin and errors on the bare pin.
moon = "2.6.4"
node = "24.22.1"
npm = "12.2.1"
uv = "0.13.6"
python = "3.14.10"
pnpm = "12.15.0"

[settings]
auto-install = true
auto-clean = true
