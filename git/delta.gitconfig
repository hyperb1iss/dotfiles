# delta as the git pager, layered on the SilkCircuit include in ~/.gitconfig.
# The feature name matches the [delta "silkcircuit-<variant>"] table that the
# SilkCircuit installer drops into ~/.config/git, so switch both together.
# Only the desktop role links this file in, and git ignores a missing
# include, so a server without delta keeps plain paging.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	features = silkcircuit-neon
