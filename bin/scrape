#!/bin/sh
#
# Mirror a website to the current directory.
#
# Usage: scrape https://example.com/some/path
#
# The flags below used to carry inline `${comment# ...}` annotations, which is
# a parameter-expansion trick rather than a real comment: every one of them
# expanded an unset variable, so the flags were also silently subject to word
# splitting. The explanations live here instead.
#
#   --recursive              follow links
#   --no-parent              never crawl above the base of the URL
#   --convert-links          rewrite links on the domain to relative, others absolute
#   --random-wait --wait 3   throttle so the host does not ban you
#   --no-http-keep-alive     ditto
#   --no-host-directories    do not nest output under a domain-name folder
#   --execute robots=off     ignore robots.txt
#   --user-agent=Mozilla/5.0 present as a browser
#   --level=inf --accept '*' do not stop at 5 levels or common file types
#   --reject "index.html*"   drop directory indexes; omit for an exact mirror
#   --cut-dirs=0             strip N leading path components; 0 keeps the whole domain

set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: ${0##*/} URL" >&2
  exit 2
fi

wget --recursive \
  --no-parent \
  --convert-links \
  --random-wait --wait 3 --no-http-keep-alive \
  --no-host-directories \
  --execute robots=off --user-agent=Mozilla/5.0 \
  --level=inf --accept '*' \
  --reject "index.html*" \
  --cut-dirs=0 \
  "$1"
