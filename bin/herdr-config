#!/usr/bin/env bash
#
# ╭──────────────────────────────────────────────────────────────╮
# │  herdr-config ⚡ compose ~/.config/herdr/config.toml          │
# │  Part of the SilkCircuit dotfiles ecosystem                  │
# ╰──────────────────────────────────────────────────────────────╯
#
# Herdr reads exactly one config.toml and has no include mechanism, so the
# settings dotfiles owns and the theme SilkCircuit owns meet in a generated
# file. This writes it from three inputs:
#
#   herdr/config.toml           tracked settings, no [theme] table
#   silkcircuit-<dark>.toml     dark variant, dropped by the SilkCircuit
#   silkcircuit-<light>.toml    installer next to the config (auto switch)
#
# Variants come from HERDR_DARK_VARIANT (default glow) and
# HERDR_LIGHT_VARIANT (default dawn). When the installer has not themed
# herdr yet the settings still land and the theme joins on the next run.
# The composed file is validated with `herdr config check` before it
# replaces the live one, and a running server is told to reload.

set -euo pipefail

# ~/bin is a link to the repo's bin/, so resolve through it.
script_path=$(readlink -f "${BASH_SOURCE[0]}" 2> /dev/null || printf '%s' "${BASH_SOURCE[0]}")
DOTFILES="${DOTFILES:-$(cd "$(dirname "${script_path}")/.." && pwd)}"

purple=$'\033[38;2;225;53;255m'
green=$'\033[38;2;80;250;123m'
coral=$'\033[38;2;255;99;99m'
gray=$'\033[38;2;98;114;164m'
reset=$'\033[0m'

info() { printf '%s→%s %s\n' "${purple}" "${reset}" "$*"; }
ok() { printf '%s✓%s %s\n' "${green}" "${reset}" "$*"; }
dim() { printf '  %s%s%s\n' "${gray}" "$*" "${reset}"; }
fail() {
  printf '%s×%s %s\n' "${coral}" "${reset}" "$*" >&2
  exit 1
}

settings="${DOTFILES}/herdr/config.toml"
config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/herdr"
target="${config_dir}/config.toml"
dark="${HERDR_DARK_VARIANT:-glow}"
light="${HERDR_LIGHT_VARIANT:-dawn}"
marker="# generated by bin/herdr-config from herdr/config.toml, do not edit"

[[ -f "${settings}" ]] || fail "missing ${settings}"

if ! command -v herdr > /dev/null 2>&1 && [[ ! -d "${config_dir}" ]]; then
  dim "herdr not installed, nothing to compose"
  exit 0
fi

# The key = value lines of a variant file's [theme.custom] table.
theme_table() {
  awk '
    /^\[theme\.custom\]/ { on = 1; next }
    /^\[/ { on = 0 }
    on && /^[a-z_0-9]+[ \t]*=/ { print }
  ' "$1"
}

dark_file="${config_dir}/silkcircuit-${dark}.toml"
light_file="${config_dir}/silkcircuit-${light}.toml"

tmp=$(mktemp "${TMPDIR:-/tmp}/herdr-config.XXXXXX")
trap 'rm -f "${tmp}"' EXIT

{
  printf '%s\n' "${marker}"
  printf '# settings: %s\n' "${settings}"
  if [[ -f "${dark_file}" && -f "${light_file}" ]]; then
    printf '# theme: silkcircuit %s (dark) / %s (light)\n' "${dark}" "${light}"
  fi
  printf '\n'
  cat "${settings}"
  if [[ -f "${dark_file}" && -f "${light_file}" ]]; then
    printf '\n[theme]\nname = "terminal"\nauto_switch = true\n'
    printf 'dark_name = "terminal"\nlight_name = "terminal"\n'
    printf '\n[theme.custom.dark]\n'
    theme_table "${dark_file}"
    printf '\n[theme.custom.light]\n'
    theme_table "${light_file}"
  fi
} > "${tmp}"

if command -v herdr > /dev/null 2>&1; then
  if ! check=$(HERDR_CONFIG_PATH="${tmp}" herdr config check 2>&1); then
    printf '%s\n' "${check}" >&2
    fail "composed config failed herdr config check, live file untouched"
  fi
fi

mkdir -p "${config_dir}"
if [[ -f "${target}" ]] && ! grep -qF "${marker}" "${target}"; then
  backup="${target}.pre-dotfiles.$(date +%Y%m%d%H%M%S)"
  mv "${target}" "${backup}"
  dim "backed up hand-written config to ${backup}"
fi

if [[ -f "${target}" ]] && cmp -s "${tmp}" "${target}"; then
  ok "herdr config unchanged"
  exit 0
fi

cp "${tmp}" "${target}"
if [[ -f "${dark_file}" && -f "${light_file}" ]]; then
  ok "composed ${target} with silkcircuit ${dark}/${light}"
else
  ok "composed ${target} (settings only)"
  dim "no silkcircuit-${dark}.toml / silkcircuit-${light}.toml in ${config_dir} yet"
fi

if [[ -S "${config_dir}/herdr.sock" ]] && command -v herdr > /dev/null 2>&1; then
  if herdr server reload-config > /dev/null 2>&1; then
    info "running herdr server reloaded"
  else
    dim "herdr server did not reload; prefix then shift+r inside herdr"
  fi
fi
